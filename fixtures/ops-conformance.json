    {
      "name": "switchAgent: the command changes nothing; the node's agentId patch does",
      "initial": [
        {
          "kind": "missionAgent",
          "id": "ma-1",
          "missionId": "m-1",
          "agentId": "a-codex",
          "role": "builder",
          "enabled": true,
          "status": "working",
          "statusDetail": null,
          "steeredBy": null,
          "task": null,
          "startedAt": null,
          "branch": null,
          "latest": []
        }
      ],
      "ops": [
        {
          "id": "01J0000000000000000000000S",
          "hlc": "0001732180000100:000000:n1",
          "actor": "p-mark",
          "body": {
            "type": "command",
            "node": "n-1",
            "command": {
              "type": "switchAgent",
              "missionAgentId": "ma-1",
              "agentId": "a-claude"
            }
          }
