        {
          "id": "01J0000000000000000000000T",
          "hlc": "0001732180000200:000000:n-1",
          "actor": "n-1",
          "body": {
            "type": "patch",
            "entityKind": "missionAgent",
            "id": "ma-1",
            "fields": {
              "agentId": "a-claude",
              "statusDetail": "switched from Codex"
