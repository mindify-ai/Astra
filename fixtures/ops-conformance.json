{
  "description": "Shared reducer cases. Each case starts from `initial` entities, applies `ops` in the listed order (which is NOT necessarily hlc order), and must yield `expect` (entity field subsets; null entity means absent).",
  "cases": [
    {
      "name": "put creates entity",
      "initial": [],
      "ops": [
        {
          "id": "01J0000000000000000000000A",
          "hlc": "0001732180000000:000000:n1",
          "actor": "p-mark",
          "body": {
            "type": "put",
            "entity": {
              "kind": "person",
              "id": "p-x",
              "name": "Xu",
              "initials": "XU"
            }
          }
        }
      ],
      "expect": [
        {
          "kind": "person",
          "id": "p-x",
          "fields": {
            "name": "Xu",
            "initials": "XU"
          }
        }
      ]
    },
    {
      "name": "patch is last-writer-wins per field regardless of arrival order",
