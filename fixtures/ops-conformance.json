        }
      ],
      "ops": [
        {
          "id": "01J0000000000000000000000U",
          "hlc": "0001732180000100:000000:n1",
          "actor": "p-mark",
          "body": {
            "type": "put",
            "entity": {
              "kind": "agentType",
              "id": "at-1",
