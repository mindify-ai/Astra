          "startedAt": null,
          "branch": null,
          "latest": []
        }
      ],
      "ops": [
        {
          "id": "01J0000000000000000000000C",
          "hlc": "0001732180000300:000000:n2",
          "actor": "n2",
          "body": {
            "type": "patch",
            "entityKind": "missionAgent",
            "id": "ma-1",
            "fields": {
              "status": "needsYou"
            }
          }
        },
        {
          "id": "01J0000000000000000000000B",
          "hlc": "0001732180000200:000000:n1",
          "actor": "n1",
          "body": {
            "type": "patch",
            "entityKind": "missionAgent",
            "id": "ma-1",
            "fields": {
