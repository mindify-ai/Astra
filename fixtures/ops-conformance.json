          "actor": "n1",
          "body": {
            "type": "patch",
            "entityKind": "person",
            "id": "p-unknown",
            "fields": {
              "name": "nobody"
            }
          }
        },
        {
          "id": "01J0000000000000000000000K",
          "hlc": "0001732180000200:000000:n1",
          "actor": "n1",
          "body": {
            "type": "delete",
            "entityKind": "person",
            "id": "p-d"
          }
        },
        {
          "id": "01J0000000000000000000000L",
          "hlc": "0001732180000150:000000:n2",
          "actor": "n2",
          "body": {
            "type": "patch",
            "entityKind": "person",
            "id": "p-d",
            "fields": {
              "name": "late"
            }
          }
        }
      ],
      "expect": [
        {
          "kind": "person",
          "id": "p-unknown",
          "fields": null
        },
        {
          "kind": "person",
          "id": "p-d",
          "fields": null
        }
      ]
    },
