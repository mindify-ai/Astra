{
  "name": "astra",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @astra/web dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "biome check .",
    "format": "biome format --write .",
    "tokens": "pnpm --filter @astra/tokens build",
    "e2e": "cargo build -p astra-server -p astrad && node scripts/e2e-stack.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "turbo": "2.11.13",
    "typescript": "5.9.3"
  }
}
