{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Astra",
  "version": "0.1.0",
  "identifier": "ai.mindify.astra",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Astra",
        "width": 1440,
        "height": 960,
        "minWidth": 960,
        "minHeight": 640,
        "decorations": false,
        "backgroundColor": "#000000",
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost ws: wss: https: http://127.0.0.1:* http://localhost:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Every agent. One workspace.",
    "longDescription": "Run coding agents from any vendor or harness on the same repository, together with your team — locally or remotely, online or offline.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": { "minimumSystemVersion": "12.0" },
    "linux": { "deb": { "depends": [] } }
  }
}
